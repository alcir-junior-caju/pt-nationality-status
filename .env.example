# Copie este arquivo para .env e preencha os valores.

# Chave da API do Gemini, usada pelo hcaptcha-challenger para resolver os desafios.
# Crie em https://aistudio.google.com/app/apikey num projeto sem cobrança ativada
# para ficar no plano gratuito.
GEMINI_API_KEY=

# Código do processo, que o site chama de "senha de acesso" (ex.: 1234-5678-9012).
# Uma senha passada na linha de comando tem prioridade.
SENHA_ACESSO=

# true roda sem abrir a janela do navegador.
# --headless e --no-headless na linha de comando têm prioridade.
HEADLESS=false

# Modelos do Gemini em ordem de preferência, separados por vírgula (opcional; abaixo está o
# padrão do script). O primeiro resolve os desafios; o seguinte entra quando o anterior falha
# (como o erro 503 de alta demanda) ou não responde. Os gemini-2.5-* não aceitam mais chaves
# novas, e um modelo Pro, como o gemini-3.1-pro-preview, exige cobrança ativada no projeto.
# GEMINI_MODELOS=gemini-3.8-flash,gemini-3.1-flash-lite
